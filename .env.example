# Copy to .env and fill in. Never commit .env: it grants full impersonation of your Telegram account.

# Telegram bot token from @BotFather (required)
TG_BOT_TOKEN=replace-with-your-telegram-bot-token

# OpenRouter API key from https://openrouter.ai/keys (required)
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Reply model id on OpenRouter (any id from https://openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-5.5

# Your own numeric Telegram user id (required; get it from @userinfobot). Owner commands and the owner-skip guard use it.
OWNER_USER_ID=123456789

# Your first name, substituted for {owner_first_name} in the persona prompts
OWNER_FIRST_NAME=Alex

# SQLite database path (stored in plaintext; put it on an encrypted disk)
DB_PATH=./secretary.db

# Past turns of chat history sent to the model per reply
HISTORY_TURNS=12

# Optional .txt file that replaces the built-in default system prompt (leave empty to use the default)
SYSTEM_PROMPT_PATH=

# Seconds to wait before auto-replying; if you reply yourself in that window, the bot aborts
AUTO_REPLY_DELAY_SECONDS=30

# Shorter delay once a chat is in "away mode" (bot replied last and you didn't step in)
AWAY_REPLY_DELAY_SECONDS=5

# Bot stays silent in a chat for this many seconds after you type there manually
OWNER_ACTIVE_COOLDOWN_SECONDS=600

# Transcribe incoming voice notes and reply to them (true/false)
VOICE_TRANSCRIBE=true

# Speech-to-text model on OpenRouter
WHISPER_MODEL=openai/whisper-large-v3

# Cheap model for memory extraction, summarization and style fingerprinting
EXTRACTOR_MODEL=google/gemini-3.1-flash-lite

# Directory holding personas/, contacts/ and about_me.txt
PROMPTS_DIR=./prompts

# Web dashboard on 127.0.0.1 only. From your computer: ssh -L 8780:127.0.0.1:8780 user@server
# Send /dashboard to the bot for a one-time login link.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8780
