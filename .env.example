# Telegram bot token from @BotFather
TG_BOT_TOKEN=replace-with-your-telegram-bot-token-from-botfather

# OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Model id on OpenRouter. Examples:
#   anthropic/claude-sonnet-4-6
#   anthropic/claude-haiku-4-5
#   openai/gpt-5
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Your own Telegram user id (NOT chat id of friends). Get from @userinfobot.
# Used to skip auto-replying to messages YOU type manually from this account.
OWNER_USER_ID=replace-with-your-numeric-telegram-user-id

# Optional: your first name. Injected into the persona prompt.
OWNER_FIRST_NAME=Sepehr

# SQLite db path (relative to cwd is fine)
DB_PATH=./secretary.db

# How many past (user+assistant) turns to send as context per reply
HISTORY_TURNS=12

# Wait this many seconds after a friend's message before auto-replying.
# Gives you time to type your own reply — if you send one, the bot aborts.
# Set to 0 to reply instantly (not recommended).
AUTO_REPLY_DELAY_SECONDS=30

# Short delay used once the chat enters "away mode" — bot already replied here
# without you preempting, so you're assumed offline/away. Resets to the full
# AUTO_REPLY_DELAY_SECONDS the moment you type manually in that chat.
AWAY_REPLY_DELAY_SECONDS=5

# If you sent anything manually in a chat within this many seconds,
# the bot stays silent for that chat. Resets every time you type.
# Default 600s = 10 minutes.
OWNER_ACTIVE_COOLDOWN_SECONDS=600

# Optional: path to a .txt file overriding the default persona prompt
SYSTEM_PROMPT_PATH=

# Voice transcription (default on). Uses openai/whisper-large-v3 via OpenRouter.
VOICE_TRANSCRIBE=true
WHISPER_MODEL=openai/whisper-large-v3

# Cheap model used for memory extraction, summarization, style fingerprinting.
EXTRACTOR_MODEL=google/gemini-3.1-flash-lite

# Directory holding optional persona + per-contact prompt .txt files.
PROMPTS_DIR=./prompts
