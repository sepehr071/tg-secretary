# Telegram bot token of the platform bot (BotFather)
PLATFORM_BOT_TOKEN=123456:replace-me
# Platform bot username, without @
PLATFORM_BOT_USERNAME=your_platform_bot
# OIDC client id from @BotFather (Login Widget / Web Login)
OIDC_CLIENT_ID=replace-me
# OIDC client secret from @BotFather
OIDC_CLIENT_SECRET=replace-me
# Model provider. Set ANTHROPIC_API_KEY to run every tenant on Claude (one shared key,
# spend metered per tenant, voice notes off). Leave it empty to use OpenRouter: then
# OPENROUTER_MGMT_KEY (a provisioning key) mints one capped key per tenant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENROUTER_MGMT_KEY=
# Public https URL of this site, no trailing slash
PUBLIC_URL=https://example.com
# Telegram user id of the platform admin
ADMIN_TG_ID=123456789
# SQLite file for the control plane
DB_PATH=./hosting.db
# Directory holding one subfolder per tenant
TENANTS_ROOT=./tenants
# Port the control plane listens on (127.0.0.1)
LISTEN_PORT=8700
# First tenant dashboard port
PORT_RANGE_START=9100
# Last tenant dashboard port
PORT_RANGE_END=9199
# Free credit in USD given to a new tenant key
TRIAL_CREDIT_USD=0
# Bump to force users to re-accept the terms (2 = retention + privacy page wording)
CONSENT_VERSION=2
# Shown on the awaiting-credit page (card number, wallet)
PAYMENT_INSTRUCTIONS=
